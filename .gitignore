# Virtual Plant Care Management System — .gitignore

# ============================================================
# NEVER commit these (secrets, build artifacts, local files)
# ============================================================

# Environment secrets
.env
.env.local
*.env

# Java build output
backend/target/
*.class
*.jar
*.war
*.ear

# Maven
backend/.mvn/repository/
!backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties

# Node / npm
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE files
.idea/
*.iml
.vscode/settings.json
.project
.classpath
.settings/
*.suo
*.user

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Test output
surefire-reports/
test-results/

